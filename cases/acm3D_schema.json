{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "description": "DNDSR constant-density ACM kernel preview configuration",
    "properties": {
        "acmSettings": {
            "type": "object",
            "description": "Constant-density ACM settings",
            "properties": {
                "rho0": {
                    "type": "number",
                    "default": 1.0,
                    "minimum": 0.0
                },
                "beta2": {
                    "type": "number",
                    "default": 1.0,
                    "minimum": 0.0
                },
                "alpha": {
                    "type": "number",
                    "default": 0.0
                },
                "dynamicViscosity": {
                    "type": "number",
                    "default": 0.0,
                    "minimum": 0.0
                },
                "riemannSolverType": {
                    "type": "string",
                    "default": "Roe",
                    "enum": ["Rusanov", "Roe"]
                },
                "pressureStorage": {
                    "type": "string",
                    "default": "PhysicalP",
                    "enum": ["PhysicalP"]
                },
                "entropyFixRatio": {
                    "type": "number",
                    "default": 0.05,
                    "minimum": 0.0
                },
                "pressureReference": {
                    "type": "number",
                    "default": 0.0
                },
                "farFieldValue": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number"}
                },
                "enableViscousFlux": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "timeMarchSettings": {
            "type": "object",
            "description": "ACM pseudo-time integration settings",
            "properties": {
                "integrator": {
                    "type": "string",
                    "default": "ExplicitSSPRK3",
                    "enum": ["ExplicitSSPRK3", "ImplicitEulerBlockJacobi"]
                },
                "nSteps": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0
                },
                "pseudoTimeStep": {
                    "type": "number",
                    "default": 0.01,
                    "minimum": 0.0
                },
                "maxImplicitIterations": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 1
                },
                "implicitTolerance": {
                    "type": "number",
                    "default": 1e-10,
                    "minimum": 0.0
                },
                "implicitRelaxation": {
                    "type": "number",
                    "default": 1.0,
                    "minimum": 0.0,
                    "maximum": 1.0
                }
            }
        },
        "leftState": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number"}
        },
        "rightState": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number"}
        },
        "unitNormal": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
        },
        "nFacesPerRank": {
            "type": "integer",
            "default": 1,
            "minimum": 1
        }
    }
}
